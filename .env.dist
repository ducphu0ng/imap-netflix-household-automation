# IMAP Configs
IMAP_USER='changeme'
IMAP_PASSWORD='changeme'
IMAP_HOST='changeme'
# usually Port 993 is used for IMAP (default 993)
IMAP_PORT='changeme'
# Mailbox/folder to listen on, e.g. "INBOX/netflix" (default INBOX)
# "/" or "." as separator both work, the real path is resolved automatically
IMAP_MAILBOX='INBOX'
# set to "false" only if your IMAP server uses a self-signed certificate (default true)
IMAP_TLS_REJECT_UNAUTHORIZED='true'

# Email Configs
TARGET_EMAIL_ADDRESS='changeme'
TARGET_EMAIL_SUBJECT='changeme'
